{
  "name": "edumotion",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/renderer",
    "packages/frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=packages/shared",
    "build:renderer": "npm run build --workspace=packages/renderer",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "build": "npm run build:shared && npm run build:renderer && npm run build:backend && npm run build:frontend",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "typecheck": "tsc --build",
    "lint": "eslint packages/**/src --ext .ts,.tsx",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
