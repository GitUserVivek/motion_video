# EduMotion AI — Environment Configuration
# Copy this file to .env and adjust as needed.

# Server
PORT=3001
NODE_ENV=production

# ── Local LLM (node-llama-cpp) ───────────────────────────────────────────────
# Directory where model weights are stored.
# Default: one level above the project root → <parent>/models/
# MODELS_DIR=/absolute/path/to/models

# Sub-folder name inside MODELS_DIR (also the download directory name).
LLM_MODEL_NAME=qwen2.5-7b-instruct-q4

# HuggingFace repo and filename to download on first run.
LLM_HF_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
LLM_HF_FILE=qwen2.5-7b-instruct-q4_k_m.gguf

# Override the loaded filename if it differs from LLM_HF_FILE (optional).
# LLM_MODEL_FILE=my-custom-name.gguf

# Context window (tokens). Reduce if you run out of RAM.
LLM_CONTEXT_SIZE=4096

# GPU layers to offload. 0 = CPU only. -1 = auto (uses all VRAM available).
LLM_GPU_LAYERS=0

# Max tokens the model generates per request.
LLM_MAX_TOKENS=2048

# Generation timeout in milliseconds.
LLM_TIMEOUT_MS=180000

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AriaNeural

# ── Rendering ─────────────────────────────────────────────────────────────────
RENDER_FPS=30
MAX_CONCURRENT_JOBS=1
MAX_RETRY_COUNT=2

# ── Database (optional override) ──────────────────────────────────────────────
# DB_PATH=./data/edumotion.db
