# Anupam Classes — Environment Configuration
# Copy this file to .env and adjust as needed.

# Server
PORT=3001
NODE_ENV=production

# ── Local LLM (node-llama-cpp) ───────────────────────────────────────────────
# Directory where model weights are stored.
# Default: one level above the project root → <parent>/models/
# MODELS_DIR=/absolute/path/to/models

# Sub-folder name inside MODELS_DIR (also the download directory name).
LLM_MODEL_NAME=qwen3-8b-instruct-q4

# HuggingFace repo and filename to download on first run.
LLM_HF_REPO=Qwen/Qwen3-8B-GGUF
LLM_HF_FILE=qwen3-8b-instruct-q4_k_m.gguf

# Override the loaded filename if it differs from LLM_HF_FILE (optional).
# LLM_MODEL_FILE=my-custom-name.gguf

# Context window (tokens). Reduce if you run out of RAM.
LLM_CONTEXT_SIZE=4096

# GPU layers to offload: auto/-1 = offload what fits in VRAM, max = all layers,
# 0 = CPU only. Use 0 if the machine has no usable GPU driver.
LLM_GPU_LAYERS=auto

# Prebuilt CUDA binaries need a driver at least as new as the CUDA toolkit they
# were compiled with. If startup aborts with "the provided PTX was compiled with
# an unsupported toolchain", set this to true to compile llama.cpp once with the
# local CUDA toolkit (first start can take up to an hour; later starts reuse it).
# LLM_BUILD_FROM_SOURCE=true
#
# On CUDA 13 the CMake configure step can fail with
#   Target "ggml-cuda" links to CUDA::cuda_driver but the target was not found
# because no driver stub is installed. Disabling VMM for the build avoids that
# dependency. Keep it set at runtime too, so the same cached build is reused.
NODE_LLAMA_CPP_CMAKE_OPTION_GGML_CUDA_NO_VMM=ON

# Max tokens the model generates per request.
LLM_MAX_TOKENS=2048

# Generation timeout in milliseconds.
LLM_TIMEOUT_MS=180000

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AriaNeural

# ── Fact research (optional) ──────────────────────────────────────────────────
# Keyless research for numbers/dates/claims. 'none' keeps every job offline and
# marks claims unverified instead of inventing facts.
RESEARCH_PROVIDER=wikipedia
RESEARCH_TIMEOUT_MS=7000
RESEARCH_MAX_SOURCES=3

# ── Artwork discovery ─────────────────────────────────────────────────────────
# Set to off to use only hand-placed resources/assets without downloading.
ASSET_DISCOVERY=on
# ASSET_MAX_QUERIES=18
# ASSET_TIMEOUT_MS=8000
# Sources, in order of preference. All are keyless: iconify, openmoji, wikimedia,
# openverse, met, cleveland, nasa. A rate-limited source is skipped.
# ASSET_PROVIDERS=openmoji,iconify,wikimedia,openverse,met,cleveland,nasa
# Artwork check: auto/vision = the vision model below looks at every accepted
# image; tags = file-name rules only (no model call). The script model is never
# used here. Judgements are cached in data/assets/verify-cache.json.
# ASSET_VERIFY=auto
# How many ranked candidates the verifier may try before a tile falls back to
# its built-in glyph. A rejection moves on to the next-best artwork.
# ASSET_MAX_CANDIDATES=4
# Set to off to keep artwork verification on file names even when a vision
# endpoint is configured below.
# ASSET_VERIFY_VISION=on

# ── Vision model (artwork only) ─────────────────────────────────────────────
# Two models run side by side: LLM_* above writes the script, this one looks at
# artwork. It verifies every downloaded image against what the scene needs
# before the file is attached, and identifies images uploaded on Review Script.
# Any OpenAI-compatible vision endpoint works (local Qwen2.5-VL/moondream via
# Ollama, OpenRouter free model, Gemini free tier). Unset means artwork is
# accepted on file names and tags alone.
# VISION_PROVIDER=auto
# VISION_API_URL=http://127.0.0.1:11434/v1
# VISION_API_KEY=
# VISION_MODEL=qwen2.5vl:3b
# VISION_TIMEOUT_MS=30000

# ── Rendering ─────────────────────────────────────────────────────────────────
RENDER_FPS=30
MAX_CONCURRENT_JOBS=1
MAX_RETRY_COUNT=2

# ── Database (optional override) ──────────────────────────────────────────────
# DB_PATH=./data/edumotion.db
