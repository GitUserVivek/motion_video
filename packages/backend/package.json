{
  "name": "@edumotion/backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --workspace=packages/shared",
    "predev": "npm run build --workspace=packages/shared",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edumotion/shared": "*",
    "better-sqlite3": "^9.4.0",
    "cors": "^2.8.5",
    "express": "^4.19.0",
    "node-llama-cpp": "^3.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
