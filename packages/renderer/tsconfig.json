{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The composition runs in Remotion's browser, so font registration uses the
    // DOM (FontFace / document.fonts).
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
